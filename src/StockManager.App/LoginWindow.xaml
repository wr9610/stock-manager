<Window x:Class="StockManager.App.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="登录 - 进销存系统"
        Width="360" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#1B2A4A"
        FontFamily="Microsoft YaHei">
    <StackPanel VerticalAlignment="Center" Margin="40,0">
        <TextBlock Text="进销存系统" FontSize="26" FontWeight="Bold" Foreground="White" HorizontalAlignment="Center"/>
        <TextBlock Text="单机版 · 扫码管货 · 数据本地" FontSize="12" Foreground="#7A8BB0" HorizontalAlignment="Center" Margin="0,6,0,30"/>

        <TextBlock Text="用户名" Foreground="#B8C4DC" FontSize="12"/>
        <TextBox x:Name="UserBox" Margin="0,4,0,16" Padding="10,8" Background="#14203A"
                 Foreground="White" BorderBrush="#2A3D6B" FontSize="14"/>

        <TextBlock Text="密码" Foreground="#B8C4DC" FontSize="12"/>
        <PasswordBox x:Name="PassBox" Margin="0,4,0,20" Padding="10,8" Background="#14203A"
                     Foreground="White" BorderBrush="#2A3D6B" FontSize="14" KeyDown="PassBox_KeyDown"/>

        <Button x:Name="LoginBtn" Content="登  录" Background="#3B82F6" Foreground="White"
                FontSize="15" FontWeight="Bold" Padding="0,11" BorderThickness="0"
                Cursor="Hand" Click="Login_Click"/>

        <TextBlock x:Name="ErrorText" Text="" Foreground="#F08080" FontSize="12"
                   Margin="0,10,0,0" HorizontalAlignment="Center"/>
    </StackPanel>
</Window>