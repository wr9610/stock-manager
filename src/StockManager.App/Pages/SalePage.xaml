<UserControl x:Class="StockManager.App.Pages.SalePage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Loaded="OnLoaded">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部：扫码输入 + 商品名显示 -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="条码 / 商品名" FontSize="12" Foreground="Gray"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="ScanBox" FontSize="20" Padding="10,8" BorderBrush="#3B82F6"
                             BorderThickness="2"
                             KeyDown="ScanBox_KeyDown" TextChanged="ScanBox_TextChanged"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="10,0,0,0">
                        <Button Content="挂单 F4" Click="Hold_Click" Margin="0,0,6,0" Background="#F59E0B" Foreground="White" Padding="14,10" BorderThickness="0" FontSize="13"/>
                        <Button Content="取单 F5" Click="Resume_Click" Background="#10B981" Foreground="White" Padding="14,10" BorderThickness="0" FontSize="13"/>
                    </StackPanel>
                </Grid>
                <TextBlock x:Name="ResolvedInfo" FontSize="12" Margin="0,4,0,0" Foreground="#3B82F6"/>
            </StackPanel>
        </Border>

        <!-- 中间：购物车商品列表 -->
        <DataGrid Grid.Row="1" x:Name="CartGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White" RowHeight="36"
                  FontSize="13" SelectionMode="Single" SelectionUnit="FullRow"
                  BorderBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="150"/>
                <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="售价" Binding="{Binding SalePriceText}" Width="80"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="60"/>
                <DataGridTextColumn Header="金额" Binding="{Binding AmountText}" Width="90"/>
            </DataGrid.Columns>
        </DataGrid>

        <!-- 底部：合计 + 抹零 + 收款 + 找零 + 结算 -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,14" Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="快捷键：F2 结算   DELETE 删行   +/- 数量" FontSize="11" Foreground="#94A3B8" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="应收:" FontSize="15" VerticalAlignment="Center"/>
                        <TextBlock x:Name="TotalText" FontSize="24" FontWeight="Bold" Foreground="#EF4444" Margin="6,0,20,0"/>
                        <TextBlock Text="抹零:" FontSize="13" VerticalAlignment="Center"/>
                        <TextBox x:Name="DiscountBox" Text="0" Width="60" FontSize="14" Margin="4,0,12,0" Padding="6,4" TextChanged="Recalc"/>
                        <TextBlock Text="实收:" FontSize="15" VerticalAlignment="Center"/>
                        <TextBox x:Name="ReceivedBox" Width="100" FontSize="14" Margin="4,0,12,0" Padding="6,4" TextChanged="Recalc"/>
                        <TextBlock Text="找零:" FontSize="13" VerticalAlignment="Center"/>
                        <TextBlock x:Name="ChangeText" FontSize="18" FontWeight="Bold" Foreground="#10B981" Margin="6,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" x:Name="CheckoutBtn" Content="结算并打印 (F2)" FontSize="18" FontWeight="Bold"
                        Background="#3B82F6" Foreground="White" Padding="40,18" BorderThickness="0"
                        Cursor="Hand" Click="Checkout_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>