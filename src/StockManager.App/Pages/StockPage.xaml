<UserControl x:Class="StockManager.App.Pages.StockPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：模式切换 + 日期 + 搜索 -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- 左：模式（现库存 / 台账） -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <RadioButton x:Name="ModeNow" Content="当前库存" GroupName="Mode" IsChecked="True"
                                 FontSize="14" VerticalAlignment="Center" Checked="Mode_Changed"/>
                    <RadioButton x:Name="ModeLedger" Content="库存台账" GroupName="Mode" FontSize="14"
                                 Margin="16,0,0,0" VerticalAlignment="Center" Checked="Mode_Changed"/>
                </StackPanel>

                <!-- 右：台账期间选择 -->
                <StackPanel x:Name="PeriodPanel" Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="从" FontSize="13" VerticalAlignment="Center"/>
                    <DatePicker x:Name="FromDate" Margin="6,0" FontSize="13"/>
                    <TextBlock Text="至" FontSize="13" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ToDate" Margin="6,0" FontSize="13"/>
                    <Button Content="查询台账" Click="QueryLedger_Click" Padding="14,6" FontSize="13" Margin="10,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 库存列表 / 台账 -->
        <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White" RowHeight="34" FontSize="13"
                  BorderBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <!-- 动态由代码切换列 -->
            </DataGrid.Columns>
        </DataGrid>
    </Grid>
</UserControl>