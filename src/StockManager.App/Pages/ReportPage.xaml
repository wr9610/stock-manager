<UserControl x:Class="StockManager.App.Pages.ReportPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：日期范围 + 快捷区间 -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="14,10" Margin="0,0,0,12">
            <StackPanel>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="今天" FontSize="13"/>
                    <RadioButton x:Name="RToday" Content="" GroupName="Range" IsChecked="True" Margin="8,0,0,0" VerticalAlignment="Center" Checked="Range_Changed"/>
                    <TextBlock Text="本周" FontSize="13" Margin="16,0,0,0"/>
                    <RadioButton x:Name="RWeek" Content="" GroupName="Range" Margin="8,0,0,0" VerticalAlignment="Center" Checked="Range_Changed"/>
                    <TextBlock Text="本月" FontSize="13" Margin="16,0,0,0"/>
                    <RadioButton x:Name="RMonth" Content="" GroupName="Range" Margin="8,0,0,0" VerticalAlignment="Center" Checked="Range_Changed"/>
                    <TextBlock Text="自定义" FontSize="13" Margin="16,0,0,0" VerticalAlignment="Center"/>
                    <RadioButton x:Name="RCustom" Content="" GroupName="Range" Margin="8,0,0,0" VerticalAlignment="Center" Checked="Range_Changed"/>
                    <DatePicker x:Name="FromDate" Margin="6,0" FontSize="13" SelectedDateChanged="FromDate_SelectedDateChanged"/>
                    <TextBlock Text="至" FontSize="13" Margin="4,0" VerticalAlignment="Center"/>
                    <DatePicker x:Name="ToDate" FontSize="13" Margin="6,0" SelectedDateChanged="ToDate_SelectedDateChanged"/>
                </StackPanel>
                <TextBlock x:Name="RangeHint" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"
                           Text="今天：2026-09-18 00:00 ~ 2026-09-18 23:59"/>
            </StackPanel>
        </Border>

        <!-- 汇总卡片 -->
        <Grid Grid.Row="1" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="12"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Background="#EFF6FF" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="销售额" FontSize="12" Foreground="#3B82F6"/>
                    <TextBlock x:Name="SalesText" FontSize="22" FontWeight="Bold" Foreground="#1D4ED8"/>
                    <TextBlock x:Name="OrdersText" FontSize="12" Foreground="#64748B" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="2" Background="#F0FDF4" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="成本" FontSize="12" Foreground="#16A34A"/>
                    <TextBlock x:Name="CostText" FontSize="22" FontWeight="Bold" Foreground="#15803D"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="4" Background="#FEF2F2" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="折扣" FontSize="12" Foreground="#EF4444"/>
                    <TextBlock x:Name="DiscountText" FontSize="22" FontWeight="Bold" Foreground="#B91C1C"/>
                </StackPanel>
            </Border>
            <Border Grid.Column="6" Background="#FFF7ED" CornerRadius="10" Padding="16,12">
                <StackPanel>
                    <TextBlock Text="净利润" FontSize="12" Foreground="#F59E0B"/>
                    <TextBlock x:Name="ProfitText" FontSize="22" FontWeight="Bold" Foreground="#C2410C"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- 商品利润排行 Tab -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <TextBlock Text="商品利润排行（按利润降序）" FontSize="14" FontWeight="Bold" VerticalAlignment="Center"/>
        </StackPanel>

        <!-- 排行表 -->
        <DataGrid Grid.Row="3" x:Name="RankGrid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" Background="White" RowHeight="34" FontSize="13"
                  BorderBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC">
            <DataGrid.Columns>
                <DataGridTextColumn Header="#" Binding="{Binding Rank}" Width="50"/>
                <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*"/>
                <DataGridTextColumn Header="数量" Binding="{Binding Qty}" Width="80"/>
                <DataGridTextColumn Header="销售额" Binding="{Binding SalesText}" Width="110"/>
                <DataGridTextColumn Header="成本" Binding="{Binding CostText}" Width="110"/>
                <DataGridTextColumn Header="利润" Binding="{Binding ProfitText}" Width="110"/>
            </DataGrid.Columns>
        </DataGrid>

        <TextBlock x:Name="RankHint" Grid.Row="4" FontSize="11" Foreground="#94A3B8" Margin="0,6,0,0"
                   Text="该排行只统计「正常」销售单（不含已作废），退货不抵扣排行利润"/>
    </Grid>
</UserControl>