<UserControl x:Class="StockManager.App.Pages.ReturnPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶栏：选销售单 -->
        <Border Grid.Row="0" Background="White" CornerRadius="10" Padding="16,12" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="选销售单：输入单号 SO... / 日期（如 2026-09-18）后回车" FontSize="12" Foreground="#64748B"/>
                    <TextBox x:Name="FindBox" FontSize="15" Padding="8,6" KeyDown="FindBox_KeyDown"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Bottom">
                    <Button Content="🔍 加载销售单" Click="LoadSale_Click" Padding="16,8" FontSize="13"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 销售单明细（含可退数量） -->
        <Border Grid.Row="1" Background="White" CornerRadius="10" Padding="12" Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>
                <TextBlock x:Name="SaleInfoText" Grid.Row="0" FontSize="13" Foreground="#334155"
                           TextWrapping="Wrap" Margin="4,4,0,8"/>
                <DataGrid Grid.Row="1" x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" Background="White" RowHeight="34" FontSize="13"
                          SelectionMode="Single" SelectionUnit="FullRow"
                          BorderBrush="#E2E8F0" RowBackground="White" AlternatingRowBackground="#F8FAFC">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="条码" Binding="{Binding Barcode}" Width="130"/>
                        <DataGridTextColumn Header="商品名" Binding="{Binding ProductName}" Width="*"/>
                        <DataGridTextColumn Header="售价" Binding="{Binding SalePriceText}" Width="70"/>
                        <DataGridTextColumn Header="已售" Binding="{Binding Qty}" Width="60"/>
                        <DataGridTextColumn Header="已退" Binding="{Binding ReturnedQty}" Width="60"/>
                        <DataGridTextColumn Header="可退" Binding="{Binding CanReturn}" Width="70"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>

        <!-- 底部：退货数量输入 + 提交 -->
        <Border Grid.Row="2" Background="White" CornerRadius="10" Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock x:Name="SelectHint" Text="点击上面一行后，在下面输入该商品退货数量" FontSize="12" Foreground="#64748B" Margin="0,0,0,4"/>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="退货数量：" FontSize="14" VerticalAlignment="Center"/>
                        <TextBox x:Name="QtyBox" Width="100" FontSize="15" Padding="6,5" Text="1" VerticalContentAlignment="Center"/>
                        <Button Content="＋ 加入退货单" Click="AddReturn_Click" Margin="10,0,0,0" Padding="16,7" FontSize="13"/>
                        <TextBlock x:Name="ReturnTotalText" FontSize="15" FontWeight="Bold" Foreground="#EF4444" VerticalAlignment="Center" Margin="24,0,0,0"/>
                    </StackPanel>
                </StackPanel>
                <Button Grid.Column="1" Content="✅ 确认退货退款" FontSize="16" FontWeight="Bold"
                        Background="#F59E0B" Foreground="White" Padding="30,16" BorderThickness="0"
                        Click="Submit_Click"/>
            </Grid>
        </Border>
    </Grid>
</UserControl>